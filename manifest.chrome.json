{
  "manifest_version": 3,
  "name": "Workhorse Pro",
  "version": "0.1.0",
  "description": "Experiments and poweruser stuff for Workhorse.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://workhorse.bes.au/*",
    "http://localhost:3000/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://workhorse.bes.au/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://workhorse.bes.au/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
