{
  "manifest_version": 3,
  "name": "Workhorse Pro",
  "version": "0.1.0",
  "description": "Adds density to the Workhorse web app: expanded pull request detail, check and review stats, composer history and stash, and cross-workspace conversations.",
  "browser_specific_settings": {
    "gecko": {
      "id": "workhorse-pro@bes.au",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://workhorse.bes.au/*",
    "http://localhost:3000/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://workhorse.bes.au/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://workhorse.bes.au/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
